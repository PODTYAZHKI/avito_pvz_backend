# Application settings
APP_NAME=pvz-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_HTTP_PORT=8080


# Database settings
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=secret
DB_NAME=pvz
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Security
SECRET_KEY=very-secret-key

# Server
SHUTDOWN_TIMEOUT=10s